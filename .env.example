# Copy to .env and fill in real values. NEVER commit .env.
# Variable names only - no real credentials belong in this file.

# --- Server ---
PORT=5000
NODE_ENV=
# Set when running behind a reverse proxy (e.g. 1) so rate limiting sees the real client IP
TRUST_PROXY=

# --- Database ---
MONGO_URI=

# --- Auth ---
JWT_SECRET=            # at least 32 random characters in production
JWT_EXPIRES_IN=7d
UNIVERSITY_DOMAIN=     # optional, default brainwareuniversity.ac.in

# --- Frontend / CORS ---
FRONTEND_URL=          # used for Google OAuth redirects and password-reset links
CORS_ORIGIN=           # optional, comma-separated; defaults to FRONTEND_URL

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=   # absolute URL, e.g. https://<backend-host>/api/auth/google/callback

GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=   # absolute URL, e.g. https://<backend-host>/api/email/google/callback
GMAIL_OAUTH_SETUP_KEY=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=     # optional, default bw-market

# --- Email (SMTP) ---
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=          # true for port 465
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=            # optional, used for password-reset mails
ADMIN_EMAIL=           # receives admin notifications
